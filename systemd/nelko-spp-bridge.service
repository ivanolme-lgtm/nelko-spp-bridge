[Unit]
Description=Nelko SPP label printer to pty bridge
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/nelko/nelko_spp_bridge.py
EnvironmentFile=-/etc/nelko-spp-bridge.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target